{
  "name": "pycon_portugal_2027",
  "version": "0.1.0",
  "private": true,
  "description": "Front-end build for the PyCon Portugal 2027 website (Sass + JS minification)",
  "devDependencies": {
    "sass": "^1.108.1",
    "terser": "^5.51.2"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "sass --no-source-map --style=compressed pycon_portugal_2027/static/sass/project.scss pycon_portugal_2027/static/css/project.min.css",
    "build:js": "terser pycon_portugal_2027/static/js/project.js --compress --mangle --output pycon_portugal_2027/static/js/project.min.js",
    "watch": "sass --watch --no-source-map --style=compressed pycon_portugal_2027/static/sass/project.scss pycon_portugal_2027/static/css/project.min.css"
  }
}
